# Supabase — browser-visible configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only elevated client
SUPABASE_SECRET_KEY=

# OpenAI — server-only
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_API_KEY=

# ---------------------------------------------------------------------
# Frontend adapter selection (gate G-19) — DEVELOPMENT / TEST ONLY
# ---------------------------------------------------------------------
# Leave this EMPTY (or delete the line) for every participant-facing build.
# The portals then compose the REAL participant adapter, which reads and
# writes only through governed server actions under the caller's own identity.
#
# Set it to exactly `1` to compose the deterministic browser-session fixture
# instead. That mode persists nothing to Supabase, signs nobody in, and marks
# every portal surface with a permanent "Deterministic fixture mode" banner so
# a fixture screenshot can never be mistaken for a real one.
#
# It is OFF BY DEFAULT and can be turned on ONLY here, at build time. No query
# parameter, cookie, header or UI control can enable it.
NEXT_PUBLIC_BEST_COACH_FIXTURE_MODE=
