# Supabase — browser-visible configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only elevated client
SUPABASE_SECRET_KEY=

# OpenAI — server-only
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_API_KEY=

# ---------------------------------------------------------------------
# Trusted-draft transport — SERVER-ONLY, EXPLICIT, FAIL-CLOSED
# ---------------------------------------------------------------------
# `report_store_draft` is owner-only with ZERO client EXECUTE (R-27), so it
# cannot be reached through PostgREST. Two transports exist to the privileged
# role, and they are NOT interchangeable:
#
#   local   `docker exec` into the local Supabase container. Requires Docker.
#   hosted  a pooled Postgres connection. Requires SUPABASE_DB_POOLED_URL.
#
# ABSENT, blank, unknown or wrong-case ALL FAIL CLOSED — there is no default,
# because a default turns a missing setting into a silent, wrong choice. It is
# deliberately NOT inferred from NODE_ENV: a local `next build && next start`
# is also `production`, so that inference would select the hosted transport on
# a machine with no connection string.
BEST_COACH_TRUSTED_DRAFT_TRANSPORT=local

# ---------------------------------------------------------------------
# Hosted trusted-draft connection string — SERVER-ONLY SECRET
# ---------------------------------------------------------------------
# Required ONLY when BEST_COACH_TRUSTED_DRAFT_TRANSPORT=hosted.
#
# ⚠️ MUST NEVER carry a NEXT_PUBLIC_ prefix. It embeds the database password
# and connects as the `postgres` OWNER; in a browser bundle it would hand any
# visitor owner-level database access.
#
# Use the POOLED (transaction-mode, port 6543) string, not the direct one:
# serverless instances exhaust direct connections. The hosted channel sets
# `prepare: false`, which transaction-mode PgBouncer requires.
SUPABASE_DB_POOLED_URL=

# ---------------------------------------------------------------------
# HOSTED FIXTURE LOADER — LOCAL MACHINE ONLY, NEVER SET IN VERCEL
# ---------------------------------------------------------------------
# Used ONLY by `npm run fixtures:hosted`, which seeds the hosted project with
# the same ratified synthetic fixture the local loader uses. The deployed
# application never reads these — it uses the six runtime variables plus
# SUPABASE_DB_POOLED_URL and BEST_COACH_TRUSTED_DRAFT_TRANSPORT.
#
# ⚠️ NONE of these may ever carry a NEXT_PUBLIC_ prefix. Two are credentials.
#
# The loader PINS the hosted project ref in source and REFUSES any target
# that does not carry it — proven: a wrong API ref, a wrong database ref, a
# loopback target and a publishable-key-as-secret are each rejected BEFORE
# anything is created.
BEST_COACH_HOSTED_SUPABASE_URL=
BEST_COACH_HOSTED_SECRET_KEY=
BEST_COACH_HOSTED_DB_URL=

# ---------------------------------------------------------------------
# Frontend adapter selection (gate G-19) — DEVELOPMENT / TEST ONLY
# ---------------------------------------------------------------------
# Leave this EMPTY (or delete the line) for every participant-facing build.
# The portals then compose the REAL participant adapter, which reads and
# writes only through governed server actions under the caller's own identity.
#
# Set it to exactly `1` to compose the deterministic browser-session fixture
# instead. That mode persists nothing to Supabase, signs nobody in, and marks
# every portal surface with a permanent "Deterministic fixture mode" banner so
# a fixture screenshot can never be mistaken for a real one.
#
# It is OFF BY DEFAULT and can be turned on ONLY here, at build time. No query
# parameter, cookie, header or UI control can enable it.
NEXT_PUBLIC_BEST_COACH_FIXTURE_MODE=
